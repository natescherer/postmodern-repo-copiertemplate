{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "* * 1 * *"
  ],
  "azure-pipelines": {
    "enabled": true,
    "fileMatch": [
      "(^|/)(?:{%.*%})?\\.azurepipelines(?:{%.*%})?/.+\\.ya?ml(?:{%.*%})?(?:\\.jinja)?$"
    ]
  },
  "copier": {
    "description": "Copier template updates are handled via dedicated GitHub Actions Workflow/Azure DevOps pipeline",
    "enabled": false
  },
  "docker": {
    "pinDigests": true
  },
  "devcontainer": {
    "fileMatch": [
      "(^|/)devcontainer\\.json(?:\\.jinja)?$"
    ]
  },
  "github-actions": {
    "fileMatch": [
      "(^|/)(?:{%.*%})?\\.github(?:{%.*%})?/workflows/.+\\.ya?ml(?:{%.*%})?$"
    ]
  },
  "packageRules": [
    {
      "description": "Group actionlint",
      "matchPackageNames": [
        "actionlint",
        "rhysd/actionlint"
      ],
      "groupName": "actionlint"
    },
    {
      "description": "Group apprise",
      "matchPackageNames": [
        "apprise",
        "pipx:apprise"
      ],
      "groupName": "apprise"
    },
    {
      "description": "Group commitizen",
      "matchPackageNames": [
        "commitizen",
        "pipx:commitizen"
      ],
      "groupName": "commitizen"
    },
    {
      "description": "Group committed",
      "matchPackageNames": [
        "committed",
        "crate-ci/committed"
      ],
      "groupName": "committed"
    },
    {
      "description": "Group copier",
      "matchPackageNames": [
        "copier",
        "pipx:copier"
      ],
      "groupName": "copier"
    },
    {
      "description": "Group invoke",
      "matchPackageNames": [
        "invoke",
        "pipx:invoke"
      ],
      "groupName": "invoke"
    },
    {
      "description": "Group mike",
      "matchPackageNames": [
        "mike",
        "pipx:mike"
      ],
      "groupName": "mike"
    },
    {
      "description": "Group mkdocs",
      "matchPackageNames": [
        "mkdocs",
        "pipx:mkdocs"
      ],
      "groupName": "mkdocs"
    },
    {
      "description": "Group prek",
      "matchPackageNames": [
        "j178/prek",
        "aqua:j178/prek"
      ],
      "groupName": "prek"
    },
    {
      "description": "Group shellcheck",
      "matchPackageNames": [
        "shellcheck",
        "koalaman/shellcheck"
      ],
      "groupName": "shellcheck"
    },
    {
      "description": "Group tombi",
      "matchPackageNames": [
        "tombi-toml/tombi",
        "aqua:tombi-toml/tombi"
      ],
      "groupName": "tombi"
    },
    {
      "description": "Group typos",
      "matchPackageNames": [
        "crate-ci/typos",
        "aqua:crate-ci/typos"
      ],
      "groupName": "typos"
    },
    {
      "description": "Group uv",
      "matchPackageNames": [
        "uv",
        "astral-sh/uv"
      ],
      "groupName": "uv"
    },
    {
      "description": "Group yamlfmt",
      "matchPackageNames": [
        "yamlfmt",
        "google/yamlfmt"
      ],
      "groupName": "yamlfmt"
    },
    {
      "description": "Use standard major version numbers for Azure Pipelines",
      "matchDatasources": [
        "azure-pipelines-tasks"
      ],
      "extractVersion": "^(?<version>\\d+)"
    }
  ],
  "customManagers": [
    {
      "description": "Manager for simple mise tools",
      "customType": "regex",
      "fileMatch": [
        "mise\\..*toml\\.jinja"
      ],
      "matchStrings": [
        "{#[-]? renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s*#}\\s+[A-Za-z0-9_\\-\"':/]+\\s?=\\s?[\"'](?<currentValue>[^\"']*)[\"'].*"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Manager for pipx tools with options",
      "customType": "regex",
      "datasourceTemplate": "pypi",
      "fileMatch": [
        "mise\\..*toml\\.jinja"
      ],
      "matchStrings": [
        "\\[tools\\.\"?pipx:(?<depName>[^\"\\]]+)\"?\\]\\sversion = \"(?<currentValue>[^\\s]*)\""
      ],
      "versioningTemplate": "pep440"
    },
    {
      "description": "Manager for pipx tool dependencies",
      "customType": "regex",
      "datasourceTemplate": "pypi",
      "fileMatch": [
        "mise\\..*toml(?:\\.jinja)?"
      ],
      "matchStrings": [
        ".*?(--with\\s(?<depName>.+?)(\\[\\S+])*==(?<currentValue>[^\"\\s]*))"
      ],
      "versioningTemplate": "pep440"
    }
  ]
}
