name: "[Test] Integration Test"

on:
  schedule:
    - cron: 0 19 * * 1 # Every Monday at 7pm UTC
  workflow_dispatch:

concurrency:
  group: integration-test
  cancel-in-progress: false

jobs:
  integration-test-github:
    runs-on: ubuntu-latest
    timeout-minutes: 20 # Verify polls for up to 2 minutes waiting on the Settings App
    permissions:
      contents: read
    steps:
      - name: Checkout Repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - name: Validate Secrets Exist
        uses: ./.github/actions/require-secrets
        with:
          secrets: |
            INTEGRATION_TEST_PAT=${{ secrets.INTEGRATION_TEST_PAT }}
      - uses: jdx/mise-action@7e36c90d9ab29c415a2384db3006f3ec8a8cc654 # v4
        with:
          experimental: true
      - name: Create, Verify, and Clean Up Test Repo
        # Same script `mise run integration-test-gh` runs locally (there, --cleanup is
        # left off so the repo stays around for inspection) -- see
        # scripts/integration_test_github.py for what this actually verifies and why,
        # including the Settings App polling and why `gh repo create` (in _tasks)
        # creates under whichever account INTEGRATION_TEST_PAT authenticates as, not
        # necessarily this repo's own owner. GITHUB_REPOSITORY is always set by GitHub
        # regardless of trigger type, so this doesn't need to be templated.
        env:
          GH_TOKEN: ${{ secrets.INTEGRATION_TEST_PAT }}
        run: |
          python scripts/integration_test_github.py \
            --source "https://github.com/$GITHUB_REPOSITORY" \
            --vcs-ref="${{ github.ref_name }}" \
            --repo-prefix "${GITHUB_REPOSITORY#*/}" \
            --cleanup \
            --ci
  integration-test-azdo:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
    env:
      # No way to auto-detect which Azure DevOps org/project the throwaway repo
      # should be created in (unlike the AzDO-hosted integration test pipeline, which
      # reads that from its own pipeline variables) -- replace these with your real
      # org/project. Left as placeholders, the job below fails fast with an
      # explanatory error instead of a confusing az CLI one.
      AZDO_INTEGRATION_TEST_ORG: CHANGE_ME
      AZDO_INTEGRATION_TEST_PROJECT: CHANGE_ME
    steps:
      - name: Checkout Repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - name: Validate Secrets Exist
        uses: ./.github/actions/require-secrets
        with:
          secrets: |
            AZURE_DEVOPS_EXT_PAT=${{ secrets.AZURE_DEVOPS_EXT_PAT }}
      - uses: jdx/mise-action@7e36c90d9ab29c415a2384db3006f3ec8a8cc654 # v4
        with:
          experimental: true
      - name: Install Azure DevOps CLI Extension
        run: az extension add --name azure-devops --only-show-errors
      - name: Create, Verify, and Clean Up Test Repo
        # Same script `mise run integration-test-azdo` runs locally (there, --cleanup
        # is left off so the repo stays around for inspection) -- see
        # scripts/integration_test_azdo.py for what this verifies and why, including
        # why it targets Azure DevOps regardless of this project's own
        # developer_platform. AZURE_DEVOPS_EXT_PAT is the exact env var name the
        # az CLI's azure-devops extension auto-detects for non-interactive auth.
        env:
          AZURE_DEVOPS_EXT_PAT: ${{ secrets.AZURE_DEVOPS_EXT_PAT }}
        run: |
          python scripts/integration_test_azdo.py \
            --source "https://github.com/$GITHUB_REPOSITORY" \
            --vcs-ref="${{ github.ref_name }}" \
            --repo-prefix "${GITHUB_REPOSITORY#*/}" \
            --org "$AZDO_INTEGRATION_TEST_ORG" \
            --project "$AZDO_INTEGRATION_TEST_PROJECT" \
            --cleanup \
            --ci
  workflow-keepalive:
    if: github.event_name == 'schedule'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      actions: write
    steps:
      - uses: liskin/gh-workflow-keepalive@581532d619d4390ec4ec5c34376cee42462fd1d6 # v1
