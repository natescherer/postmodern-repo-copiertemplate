# The Settings GitHub App (https://github.com/apps/settings) applies this file to the
# repo. Change repo settings here, not in the GitHub UI. Changes take effect once the
# app has access to this repo; see
# {{ docs_url }}getting-started/prerequisites{{ docs_page_suffix }}.

repository:
  description: "{{ project_description }}"
  homepage: "{% if is_public and zensical_ghpages %}{{ docs_root }}{% endif %}"
  private: {% if is_public %}false{% else %}true{% endif %}

  # Deliberate overrides of GitHub's defaults
  allow_auto_merge: true
  allow_merge_commit: false
  allow_rebase_merge: false
  delete_branch_on_merge: true
{%- if is_public %}

  # Public repos only: private repos need a paid GitHub Advanced Security license.
  # Personal accounts' new public repos have it by default and org-owned ones don't,
  # so this sets it explicitly.
  security_and_analysis:
    secret_scanning:
      status: enabled
    secret_scanning_push_protection:
      status: enabled
{%- endif %}

# The Settings App deletes any label not in this list, including GitHub's defaults
# (bug, enhancement, and so on), so those are listed too.
labels:
  # GitHub Defaults
  - name: accessibility
    color: f143ab
    description: Barrier affecting people with disabilities
  - name: bug
    color: d73a4a
    description: Something isn't working
  - name: documentation
    color: 0075ca
    description: Improvements or additions to documentation
  - name: duplicate
    color: cfd3d7
    description: This issue or pull request already exists
  - name: enhancement
    color: a2eeef
    description: New feature or request
  - name: good first issue
    color: 7057ff
    description: Good for newcomers
  - name: help wanted
    color: "008672"
    description: Extra attention is needed
  - name: invalid
    color: e4e669
    description: This doesn't seem right
  - name: question
    color: d876e3
    description: Further information is requested
  - name: wontfix
    color: ffffff
    description: This will not be worked on

  # Custom
  - name: awaiting pr
    color: 668F04
    description: Awaiting completion of a PR from a contributor
  - name: blocked
    color: f28c28
    description: Blocked by an external dependency

rulesets:
  - name: default-branch-protection
    target: branch
    enforcement: active
    # actor_id 5 is the built-in "admin" repository role (undocumented, but see
    # https://github.com/github/rest-api-description/issues/4406). bypass_mode
    # "pull_request" lets an admin skip requirements only when merging a PR (the "Merge
    # without waiting for requirements" button), not push past the ruleset as "always"
    # would.
    bypass_actors:
      - actor_type: RepositoryRole
        actor_id: 5
        bypass_mode: pull_request
    conditions:
      ref_name:
        exclude: []
        include: ["~DEFAULT_BRANCH"]
    rules:
      - type: deletion
      - type: non_fast_forward
      - type: pull_request
        parameters:
          dismiss_stale_reviews_on_push: false
          require_code_owner_review: false
          require_last_push_approval: false
          required_approving_review_count: 0
          required_review_thread_resolution: false
      - type: required_status_checks
        parameters:
          do_not_enforce_on_create: true
          # Matches Azure DevOps, where queue-on-source-update-only false requires
          # valid-duration 0 (recheck as soon as the target branch updates), so both
          # platforms are equally strict.
          strict_required_status_checks_policy: true
          required_status_checks:
            # The job id of test-auto-prvalidation.yml.jinja's "tests" job, which has no
            # `name:`, so its check run uses the id.
            - context: tests
{%- if zensical_ghpages %}

environments:
  - name: github-pages
{%- endif %}
