# $schema: https://noirbizarre.github.io/gh-settings/schema/v1/settings.json
# gh-settings (https://github.com/noirbizarre/gh-settings) applies this file to the repo:
# change repo settings here, not in the GitHub UI, then run `mise run
# sync-repo-settings` to apply them. It uses your `gh auth login` credential, which
# needs admin access to the repo; see
# {{ docs_url }}reference/manual-repo-settings{{ docs_page_suffix }}.
version: 1

repository:
  description: "{{ project_description }}"
  homepage: "{% if is_public and zensical_ghpages %}{{ docs_root }}{% endif %}"
  private: {% if is_public %}false{% else %}true{% endif %}

  # Deliberate overrides of GitHub's defaults
  allow_auto_merge: true
  allow_merge_commit: false
  allow_rebase_merge: false
  delete_branch_on_merge: true
{%- if is_public %}

  # Public repos only: private repos need a paid GitHub Advanced Security license.
  # Personal accounts' new public repos have it by default and org-owned ones don't,
  # so this sets it explicitly.
  security:
    secret_scanning: true
    secret_scanning_push_protection: true
{%- endif %}

actions:
  # Lets the default GITHUB_TOKEN open and update pull requests, which a new repo
  # doesn't allow; Release (Auto): Prepare Release PR and Docs (Auto): Zensical Build &
  # Commit need it to run without a Personal Access Token. Despite the field's name,
  # it doesn't let the token approve reviews.
  can_approve_pull_request_reviews: true
  # GitHub's default, stated so it stays that way: every job here declares its own
  # `permissions:`.
  default_workflow_permissions: read
{%- if zensical_ghpages %}

pages:
  build_type: workflow
{%- endif %}

# Labels added to GitHub's defaults (bug, enhancement, and so on), which stay as GitHub
# creates them; gh-settings leaves labels this list doesn't name alone.
labels:
  - name: awaiting pr
    color: 668F04
    description: Awaiting completion of a PR from a contributor
  - name: blocked
    color: f28c28
    description: Blocked by an external dependency

rulesets:
  - name: default-branch-protection
    target: branch
    enforcement: active
    # actor_id 5 is the built-in "admin" repository role (undocumented, but see
    # https://github.com/github/rest-api-description/issues/4406). bypass_mode
    # "pull_request" lets an admin skip requirements only when merging a PR (the "Merge
    # without waiting for requirements" button), not push past the ruleset as "always"
    # would.
    bypass_actors:
      - actor_type: RepositoryRole
        actor_id: 5
        bypass_mode: pull_request
    conditions:
      ref_name:
        exclude: []
        include: ["~DEFAULT_BRANCH"]
    rules:
      - type: deletion
      - type: non_fast_forward
      - type: pull_request
        parameters:
          dismiss_stale_reviews_on_push: false
          require_code_owner_review: false
          require_last_push_approval: false
          required_approving_review_count: 0
          required_review_thread_resolution: false
      - type: required_status_checks
        parameters:
          do_not_enforce_on_create: true
          # Matches Azure DevOps, where queue-on-source-update-only false requires
          # valid-duration 0 (recheck as soon as the target branch updates), so both
          # platforms are equally strict.
          strict_required_status_checks_policy: true
          required_status_checks:
            # The job id of test-auto-prvalidation.yml.jinja's "tests" job, which has no
            # `name:`, so its check run uses the id.
            - context: tests
{%- if zensical_ghpages %}

environments:
  # Lets any branch or tag deploy, since Docs (Auto): Zensical Publish to GitHub Pages
  # deploys on release events, whose ref is a tag; a branch-only policy would block
  # them. Explicit null means "any branch"; omitting the key would leave it unmanaged.
  - name: github-pages
    deployment_branch_policy: null
{%- endif %}
