"""Bring this repo's Azure DevOps pipeline registrations in line with .azurepipelines/.

`copier update` renames, merges, and deletes files under `.azurepipelines/` like any
other template change, but it can't reach the pipeline registrations in Azure DevOps:
`_tasks` created them with `az pipelines create`, and `_tasks` runs only on `copier
copy`. Run this once after such an update has merged to main.

For each current pipeline, it repoints one old registration at the new name and YAML
path in place, keeping its ID, run history, and variables (such as APPRISE_URL from
`mise run provision-secrets`) that deleting and recreating it would lose. It deletes
any other old registration merged into that pipeline, and the registration of a
pipeline merged into another, since their YAML files no longer exist.

It's safe to rerun: it does nothing on a project that's already migrated or never had
the old names.
"""

import argparse
import json
import shutil

# S404: drives a real CLI tool below; no untrusted input, no shell=True.
import subprocess  # noqa: S404
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
REPO_NAME = "{{ repo_name }}"
AZDO_ORG_URL = "https://dev.azure.com/{{ azdo_org }}/"
AZDO_PROJECT = "{{ azdo_project }}"

# (current display name, yml-path relative to the repo root, old display names). The
# first old name registered gets repointed; any other is deleted. Renovate comes first
# among Monthly Maintenance's, since its registration has the most variables to keep
# (APPRISE_URL and GITHUB_COM_TOKEN).
PIPELINES = (
    (
        "Maint (Auto) - Monthly Maintenance",
        ".azurepipelines/maint-auto-monthlymaintenance.yml",
        (
            "Maint (Auto) - Renovate",
            "renovate",
            "Maint (Auto) - Copier Update Check",
            "copier-update-check",
            "Maint (Auto) - Repo Health Check",
            "Maint (Auto) - Link Check",
            "link-check",
        ),
    ),
    (
        "Docs (Auto) - Zensical Build & Commit",
        ".azurepipelines/docs-auto-zensicalcommit.yml",
        ("Docs (Auto) - Zensical Build & Publish", "docs"),
    ),
    (
        "Test (Auto) - PR Validation",
        ".azurepipelines/test-auto-prvalidation.yml",
        ("pr_validation",),
    ),
    (
        "Release (Auto) - Prepare & Publish Release",
        ".azurepipelines/release-auto-release.yml",
        ("release",),
    ),
)

# (current display name, old display names) for pipelines merged into one of PIPELINES
# whose registrations have no variables worth keeping, so all of them are deleted: the
# prerelease is now a manual run of the release pipeline with a label.
RETIRED = (
    (
        "Release (Auto) - Prepare & Publish Release",
        ("Release (Manual) - Create Prerelease", "prerelease"),
    ),
)


def run(
    *args: str, check: bool = True, capture: bool = False
) -> subprocess.CompletedProcess:
    """Run a CLI command, echoing it first.

    Resolves argv[0] with shutil.which() first. On Windows, `az` is an `az.cmd` batch
    wrapper, which subprocess without a shell can't find by bare name
    (`FileNotFoundError: [WinError 2]`). which() resolves the path on any platform
    without shell=True.

    Returns:
        The completed process, with captured stdout/stderr if `capture` is True.

    """
    print(f"$ {' '.join(args)}")
    resolved = (shutil.which(args[0]) or args[0], *args[1:])
    # S603: args are always a fixed list built by this module; no shell=True.
    return subprocess.run(  # noqa: S603
        resolved, check=check, text=True, capture_output=capture
    )


def az_value(*args: str) -> str:
    """Run `az <args>` and return its trimmed stdout.

    Returns:
        The command's stdout, stripped of surrounding whitespace.

    """
    return run("az", *args, capture=True).stdout.strip()


def check_az_installed() -> None:
    """Verify the `az` CLI is resolvable on PATH.

    Raises:
        SystemExit: if `az` can't be found.

    """
    if shutil.which("az") is None:
        raise SystemExit(
            "Azure CLI ('az') not found on PATH. Install it: "
            "https://learn.microsoft.com/cli/azure/install-azure-cli"
        )


def check_azure_devops_extension() -> None:
    """Verify the azure-devops CLI extension is installed.

    `az devops`/`az repos`/`az pipelines` commands, if the extension isn't installed,
    prompt interactively to install it; which just hangs with no stdin attached.
    Checking via `az extension list` first (a core command that doesn't itself need
    the extension) avoids ever triggering that prompt.

    Raises:
        SystemExit: if the extension isn't installed.

    """
    installed = az_value(
        "extension", "list", "--query", "[?name=='azure-devops'].name", "-o", "tsv"
    )
    if not installed:
        raise SystemExit(
            "Azure CLI extension 'azure-devops' is not installed. Install it: "
            "az extension add --name azure-devops"
        )


def full(name: str) -> str:
    """Return the registered name of the pipeline whose display name is `name`.

    Returns:
        `name`, prefixed with this repo's name in brackets.

    """
    return f"[{REPO_NAME}] {name}"


def delete(
    pipeline_id: int,
    name: str,
    replacement: str,
    scope: tuple[str, ...],
    *,
    dry_run: bool,
) -> None:
    """Delete the registration `name`, which `replacement` replaces."""
    print(f"Deleting {name!r}: {replacement!r} replaces it")
    if not dry_run:
        run("az", "pipelines", "delete", "--id", str(pipeline_id), *scope, "--yes")


def migrate_pipeline(
    pipeline: tuple[str, str, tuple[str, ...]],
    by_name: dict[str, int],
    scope: tuple[str, ...],
    *,
    dry_run: bool,
) -> None:
    """Repoint one old registration of a PIPELINES entry, then delete any others.

    Whether the entry even applies to this project is decided by whether its
    `.azurepipelines/*.yml` file exists on disk; the ground truth for "this project
    needs this pipeline," since that file only exists if the project's own answers
    caused copier to render it.
    """
    current, yml_path, olds = pipeline
    if not (REPO_ROOT / yml_path).exists():
        return  # this pipeline category doesn't apply to this project

    current_full = full(current)
    old_fulls = [full(old) for old in olds if full(old) in by_name]
    if current_full in by_name:
        print(f"Already up to date: {current_full!r}")
    elif old_fulls:
        keep = old_fulls.pop(0)
        print(f"Migrating {keep!r} -> {current_full!r} ({yml_path})")
        if not dry_run:
            run(
                "az", "pipelines", "update", "--id", str(by_name[keep]),
                "--new-name", current_full, "--yml-path", yml_path, *scope,
            )  # fmt: skip
    else:
        print(
            f"WARNING: {yml_path} exists locally but no pipeline is registered "
            f"under {current_full!r} or an old name for it; create it manually, "
            "e.g. via 'az pipelines create'."
        )
    for name in old_fulls:
        delete(by_name[name], name, current_full, scope, dry_run=dry_run)


def migrate(org: str, project: str, *, dry_run: bool) -> None:
    """Repoint, then delete, registrations so each current pipeline has exactly one."""
    scope = ("--org", org, "--project", project)
    listing = az_value(
        "pipelines", "list", "--repository", REPO_NAME, *scope,
        "--query", "[].{id: id, name: name}",
    )  # fmt: skip
    by_name = {p["name"]: p["id"] for p in json.loads(listing or "[]")}
    recognized_names = set()

    for pipeline in PIPELINES:
        current, _, olds = pipeline
        recognized_names.update(map(full, (current, *olds)))
        migrate_pipeline(pipeline, by_name, scope, dry_run=dry_run)

    for current, olds in RETIRED:
        for name in map(full, olds):
            recognized_names.add(name)
            if name in by_name:
                delete(by_name[name], name, full(current), scope, dry_run=dry_run)

    cruft = sorted(name for name in by_name if name not in recognized_names)
    if cruft:
        print(
            "\nPipelines registered for this repo that don't match any known old or "
            "new name; review manually, not auto-deleted:"
        )
        for name in cruft:
            print(f"  {name!r} (id {by_name[name]})")


def main() -> None:
    """Parse args, check for `az`, then migrate this repo's pipeline registrations."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--org", default=AZDO_ORG_URL, help="Azure DevOps organization URL"
    )
    parser.add_argument("--project", default=AZDO_PROJECT, help="Azure DevOps project")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Print what would change without calling az",
    )
    args = parser.parse_args()

    check_az_installed()
    check_azure_devops_extension()
    migrate(args.org, args.project, dry_run=args.dry_run)


if __name__ == "__main__":
    sys.exit(main())
