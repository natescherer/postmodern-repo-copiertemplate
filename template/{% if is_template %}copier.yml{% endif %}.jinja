is_public:
  type: bool
  default: |-
    {%- if project_visibility == 'Public' -%}
      true
    {%- endif %}
  when: false

is_private:
  type: bool
  default: |-
    {%- if project_visibility == 'Private' -%}
      true
    {%- endif %}
  when: false
{%- endraw %}
{%- if is_extensible %}
{%- raw %}

is_standard:
  type: bool
  default: |-
    {%- if project_type == 'Standard' -%}
