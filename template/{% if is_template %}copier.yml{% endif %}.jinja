{%- raw %}

# region Migrations
# None of these has a `version:` gate. Copier checks a gate against the version of
# the template a project updates from, and a child template inheriting these has its
# own version numbers, so a gate set for this template's releases would misfire for
# its descendants. Each one runs on every update instead, so it must be safe to rerun.
_migrations:
  # region Backfill Legacy Version Into knope-current-version.json (all versions)
  # v0.8.0 replaced release-please (GitHub) and commitizen (Azure DevOps) with Knope,
  # which tracks the version in knope-current-version.json. Those tools, and the
  # commit-and-tag-version before them, all tagged releases `vX.Y.Z` as Knope does, so
  # the latest such tag is the real version. A project receives the file with a "0.0.0"
  # placeholder, and this overwrites only that placeholder. The same command runs as a
  # copy task (see _tasks) for an existing project with release tags already in place.
  - command: &seed_version_from_tag
      - "{{ _copier_python }}"
      - -c
      - |
        import json
        import re
        import subprocess
        import sys
        from pathlib import Path

        version_file = Path(".config/knope-current-version.json")
        if version_file.is_file():
            try:
                current = json.loads(
                    version_file.read_text(encoding="utf-8")
                ).get("version")
            except (json.JSONDecodeError, OSError):
                current = None
            if current != "0.0.0":
                sys.exit(0)

        result = subprocess.run(
            ["git", "describe", "--tags", "--abbrev=0", "--match", "v[0-9]*"],
            capture_output=True, text=True, check=False,
        )
        tag = result.stdout.strip()
        if result.returncode != 0 or not re.fullmatch(r"v\d+\.\d+\.\d+", tag):
            sys.exit(0)
        version = tag[1:]

        version_file.parent.mkdir(exist_ok=True)
        version_file.write_text(
            json.dumps(
                {
                    "_comment": "Managed by Knope; do not edit manually.",
                    "version": version,
                },
                indent=2,
            )
            + "\n",
            encoding="utf-8",
        )
        print(f"Seeded knope-current-version.json with {version!r} from the latest release tag.")
    when: "{{ _stage == 'after' }}"
  # endregion Backfill Legacy Version Into knope-current-version.json (all versions)

  # region Knope Changelog Reformatter (all versions)
  # release-please wrote CHANGELOG.md headings as `## [X.Y.Z](url) (date)`, which
  # Knope can't parse: without a heading it recognizes, it appends new releases at the
  # end of the file. This rewrites them as `## X.Y.Z (date)`. A heading already in that
  # form doesn't match, so rerunning it changes nothing.
  - command:
      - "{{ _copier_python }}"
      - -c
      - |
        import re
        from pathlib import Path

        path = Path("CHANGELOG.md")
        if path.is_file():
            with path.open(encoding="utf-8", newline="") as f:
                content = f.read()
            new_content, count = re.subn(
                r"^## \[(\d+\.\d+\.\d+)\]\([^)]+\) (\(\d{4}-\d{2}-\d{2}\))$",
                r"## \1 \2",
                content,
                flags=re.MULTILINE,
            )
            if count:
                path.write_text(new_content, encoding="utf-8", newline="")
                print(f"Reformatted {count} changelog heading(s) for Knope.")
    when: "{{ _stage == 'after' }}"
  # endregion Knope Changelog Reformatter (all versions)

  # region Reminder to Remove REPO_MAINTENANCE_PAT (all versions)
  # v0.8.2 dropped REPO_MAINTENANCE_PAT: the GitHub workflows that used it run as the
  # default GITHUB_TOKEN, at the cost of a manual approval for each bot-authored push.
  # A project updating past v0.8.2 may still have the secret set. This checks with
  # `gh secret list` and prints a reminder only when it's there, and exits quietly
  # without `gh`, so the update and the changeset generator after it still run.
  - command:
      - "{{ _copier_python }}"
      - -c
      - |
        import shutil, subprocess, sys

        if not shutil.which("gh"):
            sys.exit(0)
        try:
            result = subprocess.run(
                ["gh", "secret", "list", "--json", "name"],
                capture_output=True, text=True, check=False,
            )
        except OSError:
            sys.exit(0)
        if result.returncode == 0 and '"REPO_MAINTENANCE_PAT"' in result.stdout:
            print(
                "REPO_MAINTENANCE_PAT is no longer used by this template's GitHub "
                "workflows. Delete it from Settings > Secrets and variables > "
                "Actions, and revoke the token itself at "
                "https://github.com/settings/tokens if you're not using it "
                "elsewhere. See {{ parent_template_docs_url }}maintaining/upgrading-from-0x{{ parent_template_docs_suffix }} "
                "for what changed."
            )
    when: "{{ _stage == 'after' and using_github }}"
  # endregion Reminder to Remove REPO_MAINTENANCE_PAT (all versions)

  # region Upstream Change to Changeset Generator (all versions)
  # Writes a changeset for each relevant upstream change, so it reaches this project's
  # changelog instead of disappearing into a "chore: apply parent template" commit. It
  # runs Knope's compute-upstream-bump workflow in a temporary clone of the template,
  # with every tag but this project's pre-update version removed so Knope's "most
  # recent tag" baseline lands on that version; see the workflow's comment in
  # knope.toml. It writes nothing when no upstream commit is release-worthy.
  - command:
      - "{{ _copier_python }}"
      - -c
      - |
        import hashlib
        import re
        import shutil
        import subprocess
        import sys
        import tempfile
        import tomllib
        from pathlib import Path
        from urllib.parse import unquote

        version_from, version_to, src_path, upstream = (
            sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4],
        )
        if version_from == version_to:
            sys.exit(0)

        def run(*args, cwd=None, check=True):
            return subprocess.run(
                args, cwd=cwd, check=check, capture_output=True,
                encoding="utf-8", errors="replace",
            )

        scratch = Path(tempfile.mkdtemp())
        try:
            run("git", "clone", "--quiet", src_path, str(scratch))
            tags = run("git", "tag", cwd=scratch).stdout.split()
            if version_from not in tags:
                print(
                    f"Note: {version_from} isn't a tag in {upstream}, so no changesets "
                    "were generated for this update."
                )
                sys.exit(0)
            run("git", "checkout", "--quiet", version_to, cwd=scratch)
            for tag in tags:
                if tag != version_from:
                    run("git", "tag", "-d", tag, cwd=scratch, check=False)

            # Emptied first: compute-upstream-bump works from tags and commits, not the
            # changelog, so nothing is lost, and the new entry is then the only one in
            # the file for the extraction below to read.
            (scratch / "CHANGELOG.md").write_text("", encoding="utf-8")

            result = run(
                "mise", "x", "--", "knope", "compute-upstream-bump",
                cwd=scratch, check=False,
            )
            if result.returncode != 0:
                # Nothing release-worthy upstream is a normal outcome; anything else
                # means changesets were silently lost, so say so.
                output = result.stdout + result.stderr
                if "releases::no_release" not in output:
                    lines = [line.strip() for line in output.splitlines() if line.strip()]
                    # Knope marks the error itself with U+00D7; fall back to its last line.
                    reason = next(
                        (line.lstrip("\u00d7 ") for line in lines if line.startswith("\u00d7")),
                        lines[-1] if lines else f"knope exited {result.returncode}",
                    )
                    print(f"Warning: couldn't generate changesets for this update ({reason}).")
                sys.exit(0)

            with (scratch / "CHANGELOG.md").open(encoding="utf-8", newline="") as f:
                entry = f.read().strip()
            body = entry.split("\n", 1)[1].strip() if "\n" in entry else ""

            # knope.toml's `extra_changelog_sections` can rename Knope's default
            # sections (Breaking Changes, Features, Fixes), so read the upstream's
            # config instead of assuming the defaults.
            section_names = {
                "major": "Breaking Changes",
                "minor": "Features",
                "patch": "Fixes",
            }
            knope_toml_path = scratch / "knope.toml"
            if knope_toml_path.is_file():
                knope_config = tomllib.loads(
                    knope_toml_path.read_text(encoding="utf-8")
                )
                for override in knope_config.get("package", {}).get(
                    "extra_changelog_sections", []
                ):
                    name = override.get("name")
                    if not name:
                        continue
                    for bump in section_names:
                        if bump in override.get("types", []):
                            section_names[bump] = name

            sections = tuple(section_names.items())
            section_pattern = re.compile(
                r"^### ("
                + "|".join(re.escape(name) for name in section_names.values())
                + r")\s*\n(.*?)(?=^### |\Z)",
                re.MULTILINE | re.DOTALL,
            )
            found = {
                heading: content.strip()
                for heading, content in section_pattern.findall(body)
            }

            # Knope turns a multi-line changeset's first line into a "###" heading, so
            # one file per change keeps the changelog a flat list.
            #
            # Each bullet links to where it came from. GitHub's bare "(#1234)"
            # squash-merge suffix becomes a repo-qualified link ("owner/repo#1234");
            # Azure DevOps has no such suffix, so its bullets link to the source repo.
            # A bullet that already ends in a link was attributed at an earlier hop
            # (such as a grandparent template) and stays as it is.
            github_match = re.match(
                r"^gh:([^/\s]+)/([^/\s]+)$", upstream
            ) or re.search(r"github\.com[:/]+([^/\s]+)/([^/\s.]+)", upstream)
            azdo_match = re.search(
                r"dev\.azure\.com/([^/\s]+)/([^/\s]+)/_git/([^/\s]+)", upstream
            )
            already_attributed = re.compile(r"\]\([^)]+\)\)?\s*$")
            pr_ref_pattern = re.compile(r"\(#(\d+)\)\s*$")

            def attribute(text):
                if already_attributed.search(text):
                    return text
                if github_match:
                    owner, repo = github_match.group(1), github_match.group(2)
                    ref = pr_ref_pattern.search(text)
                    if ref:
                        n = ref.group(1)
                        return pr_ref_pattern.sub(
                            f"([{owner}/{repo}#{n}]"
                            f"(https://github.com/{owner}/{repo}/issues/{n}))",
                            text,
                        )
                    return (
                        f"{text} ([{owner}/{repo}]"
                        f"(https://github.com/{owner}/{repo}))"
                    )
                if azdo_match:
                    org, project, repo = azdo_match.groups()
                    display = f"{unquote(project)}/{repo}"
                    url = f"https://dev.azure.com/{org}/{project}/_git/{repo}"
                    return f"{text} ([{display}]({url}))"
                return text

            changeset_dir = Path(".changeset")
            changeset_dir.mkdir(exist_ok=True)
            written = 0
            for bump, heading in sections:
                content = found.get(heading)
                if not content:
                    continue
                entries = []
                for line in content.splitlines():
                    if line.startswith("- "):
                        entries.append(line[2:])
                    elif entries:
                        entries[-1] += " " + line.strip()
                for entry in entries:
                    entry = attribute(entry.strip())
                    ref = re.search(r"#(\d+)", entry)
                    ident = (
                        ref.group(1) if ref
                        else hashlib.sha1(entry.encode()).hexdigest()[:8]
                    )
                    filename = (
                        f"template-update-{version_to.lstrip('v')}-{bump}-{ident}.md"
                    )
                    # The summary is a heading, as `knope document-change` writes it
                    (changeset_dir / filename).write_text(
                        f"---\ndefault: {bump}\n---\n\n# {entry}\n",
                        encoding="utf-8",
                        newline="",
                    )
                    written += 1

            if written:
                print(f"Added {written} changeset(s) from {upstream} {version_to}.")
        finally:
            shutil.rmtree(scratch, ignore_errors=True)
      - "{{ _version_from }}"
      - "{{ _version_to }}"
      - "{{ _copier_conf.src_path }}"
      - "{{ _src_path }}"
    when: "{{ _stage == 'after' }}"
  # endregion Upstream Change to Changeset Generator (all versions)
# endregion Migrations

# region Pre-Question Computed Values
lifecycle_previous:
  # The lifecycle answer from before this run, for the lifecycle question's validator.
  type: str
  default: "{{ lifecycle | default('') }}"
  when: false
# endregion Pre-Question Computed Values

# region Questions
developer_platform:
  type: str
  help: |-
    Where to host the Git repo and CI/CD. Azure DevOps support is deprecated; use GitHub
    unless you need Azure DevOps.
  ask: "{{ not project_initialized }}"
  choices:
    - GitHub
    - Azure DevOps
  default: GitHub

repo_setup_actions:
  type: str
  help: |-
    New project: 'Create Repo'. Existing project: 'Set Repo Rules' on GitHub, 'None' on Azure DevOps. No setup: 'None'.
  ask: "{{ not project_initialized }}"
  choices:
    Create Repo:
      value: Create Repo
    Set Repo Rules:
      value: Set Repo Rules
      # Azure DevOps registers pipelines from YAML on the remote main, which an existing
      # project hasn't pushed at copy time.
      validator: |-
        {%- if developer_platform == 'Azure DevOps' -%}
          Not Supported on Azure DevOps: choose None, push the generated files, then follow {{ parent_template_docs_url }}reference/manual-repo-settings{{ parent_template_docs_suffix }}
        {%- endif %}
    None:
      value: None
  default: Create Repo
  # Checks that the platform's CLI is installed and logged in.
  validator: |-
    {%- if not project_initialized and repo_setup_actions != 'None' -%}
      {%- if developer_platform == 'GitHub' -%}
        {%- set gh_check = ('gh --version && echo GH_INSTALLED' | shell()) -%}
        {%- if 'GH_INSTALLED' not in gh_check -%}
          GitHub CLI ('gh') is not installed or not on PATH. Install it, then try again.
        {%- else -%}
          {%- set gh_auth_check = ('gh api user --jq .login && echo GH_AUTHED' | shell()) -%}
          {%- if 'GH_AUTHED' not in gh_auth_check -%}
            GitHub CLI ('gh') is installed but not authenticated. Run 'gh auth login', then try again.
          {%- elif repo_setup_actions == 'Create Repo' -%}
            {%- set knope_check = ('knope --version && echo KNOPE_INSTALLED' | shell()) -%}
            {%- if 'KNOPE_INSTALLED' not in knope_check -%}
              Knope ('knope') is not installed or not on PATH. Install it (see https://knope.tech/), then try again.
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- elif developer_platform == 'Azure DevOps' -%}
        {%- set az_check = ('az --version && echo AZ_INSTALLED' | shell()) -%}
        {%- if 'AZ_INSTALLED' not in az_check -%}
          Azure CLI ('az') is not installed. Install it (see https://learn.microsoft.com/cli/azure/install-azure-cli), then try again.
        {%- else -%}
          {%- set az_ext_check = ('az extension show --name azure-devops && echo AZ_EXT_INSTALLED' | shell()) -%}
          {%- if 'AZ_EXT_INSTALLED' not in az_ext_check -%}
            Azure CLI is installed but the azure-devops extension isn't. Run 'az extension add --name azure-devops', then try again.
          {%- else -%}
            {%- set az_auth_check = ('az account show && echo AZ_AUTHED' | shell()) -%}
            {%- if 'AZ_AUTHED' not in az_auth_check -%}
              Azure CLI is installed but not logged in. Run 'az login', then try again.
            {%- elif repo_setup_actions == 'Create Repo' -%}
              {%- set knope_check = ('knope --version && echo KNOPE_INSTALLED' | shell()) -%}
              {%- if 'KNOPE_INSTALLED' not in knope_check -%}
                Knope ('knope') is not installed or not on PATH. Install it (see https://knope.tech/), then try again.
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}

github_username:
  type: str
  help: |-
    Your GitHub username; the repo is created under it unless you name an org. Defaults to the username in your Git 'user.email'.
  ask: "{{ not project_initialized }}"
  # Assumes GitHub's noreply email form (12345+username@users.noreply.github.com). Any
  # other "+"-tagged email (such as user+tag@gmail.com) defaults to the tag instead.
  default: "{{ (('git config --global user.email' | shell()).split('+') | last).split('@') | first }}"
  when: "{{ developer_platform == 'GitHub' }}"

github_org:
  type: str
  help: |-
    The GitHub organization that owns the repo, or 'None' to create it under your username.
  ask: "{{ not project_initialized }}"
  default: None
  when: "{{ developer_platform == 'GitHub' }}"

azdo_org:
  type: str
  help: |-
    The Azure DevOps organization for the repo.
  ask: "{{ not project_initialized }}"
  when: "{{ developer_platform == 'Azure DevOps' }}"

azdo_project:
  type: str
  help: |-
    The Azure DevOps project for the repo.
  ask: "{{ not project_initialized }}"
  when: "{{ developer_platform == 'Azure DevOps' }}"

repo_name:
  type: str
  help: |-
    The Git repo's name. Defaults to the destination folder's name.
  ask: "{{ not project_initialized }}"
  default: "{{ _copier_conf.dst_path | realpath | basename }}"
  validator: |-
    {%- if not (repo_name | regex_search('^[A-Za-z0-9._-]+$')) -%}
      Repo names may only contain letters, digits, '.', '_', and '-'.
    {%- endif -%}

author_name:
  type: str
  help: Who the project is credited to. Defaults to your Git 'user.name'.
  default: "{{ 'git config --global user.name' | shell() | trim }}"

{%- endraw %}
{#- A leaf template's projects are always Standard, so its copier.yml has no
    project-type questions or computed values, and no copy-template-files task. #}
{%- if is_extensible %}
{%- raw %}

project_type:
  type: str
  help: |-
    Standard for a project repo; Template for a child Copier template.
  ask: "{{ not project_initialized }}"
  choices:
    - Standard
    - Template
  default: Standard

# Defaults to no on a new copy (most templates are leaf templates) and to yes for an
# existing Template project, which was extensible before this question existed. No
# `ask:` yet, so every existing Template project answers it once on its next update.
extensible_template:
  type: bool
  help: |-
    Will other Copier templates be built from this one? No makes a leaf template, whose projects are always Standard; yes makes an extensible template.
  default: "{{ project_initialized | default(false) }}"
  when: "{{ project_type == 'Template' }}"
{%- endraw %}
{%- endif %}
{%- raw %}

project_name:
  type: str
  help: The project's display name; capitals and spaces are fine.
  validator: |-
    {%- if '"' in project_name or '\\' in project_name -%}
      The project name can't contain '"' or '\', since it's written into quoted TOML/YAML strings.
    {%- endif -%}

project_description:
  type: str
  help: A one- or two-sentence description, used in docs and packaging.
  validator: |-
    {%- if '"' in project_description or '\\' in project_description -%}
      The project description can't contain '"' or '\', since it's written into quoted TOML/YAML strings.
    {%- endif -%}

project_visibility:
  type: str
  help: |-
    Public (open source) or Private.
  ask: "{{ not project_initialized }}"
  choices:
    Public:
      value: Public
      validator: |-
        {%- if developer_platform == 'Azure DevOps' -%}
          Not Supported on Azure DevOps: choose Private
        {%- endif %}
    Private:
      value: Private
  default: |-
    {%- if developer_platform == 'Azure DevOps' -%}
      Private
    {%- else -%}
      Public
    {%- endif %}

license:
  type: str
  help: Choose the license for this project.
  choices:
    MIT:
      value: MIT
      validator: |-
        {%- if project_visibility == 'Private' -%}
          Not Supported on Private repos: choose None
        {%- endif %}
    None:
      value: None
  default: |-
    {%- if project_visibility == 'Private' -%}
      None
    {%- else -%}
      MIT
    {%- endif %}

zensical_target:
  type: str
  help: |-
    Where to publish the docs.
  ask: "{{ not project_initialized }}"
  choices:
    GitHub Pages:
      value: GitHub Pages
      validator: |-
        {%- if developer_platform == 'Azure DevOps' -%}
          Not Supported on Azure DevOps: choose docs-site Directory in Repo
        {%- endif %}
    docs-site Directory in Repo:
      value: docs-site Directory in Repo
  default: |-
    {%- if developer_platform == 'Azure DevOps' -%}
      docs-site Directory in Repo
    {%- else -%}
      GitHub Pages
    {%- endif %}

lifecycle:
  type: str
  help: The project's current stage.
  choices:
    - Pre-Alpha
    - Alpha
    - Beta
    - Stable
    - Inactive
  validator: |-
    {%- set _rank = {"Pre-Alpha": 0, "Alpha": 1, "Beta": 2, "Stable": 3} -%}
    {%- if lifecycle_previous in _rank and lifecycle in _rank and _rank[lifecycle] < _rank[lifecycle_previous] -%}
      Can't move from '{{ lifecycle_previous }}' back to '{{ lifecycle }}': lifecycle only moves forward (Pre-Alpha -> Alpha -> Beta -> Stable). 'Inactive' is a separate state, reachable from any of these.
    {%- endif -%}

agent_instructions:
  type: bool
  help: Generate AGENTS.md with instructions for AI coding agents.
  default: true

code_coverage:
  type: bool
  help: Publish code coverage through Codecov (GitHub) or Azure Pipelines (Azure DevOps). This publishes a Cobertura coverage.xml from the repo root; your test command produces it.
  default: false
# endregion Questions

# region Post-Question Computed Values
using_github:
  type: bool
  default: |-
    {%- if developer_platform == 'GitHub' -%}
      true
    {%- endif %}
  when: false

github_repo_owner:
  type: str
  default: |-
    {%- if github_org and github_org != 'None' -%}
      {{ github_org }}
    {%- else -%}
      {{ github_username }}
    {%- endif %}
  when: false

using_azdo:
  type: bool
  default: |-
    {%- if developer_platform == 'Azure DevOps' -%}
      true
    {%- endif %}
  when: false

azdo_project_encoded:
