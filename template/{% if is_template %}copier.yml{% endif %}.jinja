# The GitHub Pages site root, for links to the docs as a whole (README, repo
# homepage). It redirects to the current version, so unlike docs_url it doesn't
# depend on the versioning scheme's path layout.
docs_root:
  type: str
  default: "{{ 'https://' ~ github_repo_owner ~ '.github.io/' ~ repo_name ~ '/' if zensical_ghpages else '' }}"
  when: false

current_knope_version:
  type: str
  default: |-
    {%- set _version_file_raw = (('git -C "' ~ _copier_conf.dst_path ~ '" show HEAD:.config/knope-current-version.json 2>&1') | shell()) -%}
    {%- if '"version"' in _version_file_raw -%}
      {{- (_version_file_raw | from_json).version -}}
    {%- endif -%}
  when: false

current_knope_version_is_pre_1:
  type: bool
  default: |-
    {%- if current_knope_version.split('.')[0] == '0' -%}
      true
    {%- endif %}
  when: false

setup_checklist:
  type: str
  default: |-
    - [ ] Add or remove badges at the top of README.md.
    - [ ] Replace docs/assets/images/readme-logo.png with your own logo, or remove that section from README.md.
    - [ ] Replace docs/assets/images/readme-screenshot.png with a screenshot of your project, or remove that section from README.md.
    - [ ] Set the required secrets: run `mise run provision-secrets`, or see {{ parent_template_docs_url }}reference/token-permissions{{ parent_template_docs_suffix }}.
    {%- if using_github %}
    - [ ] If the Renovate GitHub App only has access to selected repositories, add this one.
    - [ ] When Renovate opens its **Dependency Dashboard** issue, pin it (**Pin issue** in the sidebar) to keep it at the top of the Issues tab.
    - [ ] On the first release PR, approve its PR Validation run (**Approve and run workflow**); GitHub holds runs on bot-opened PRs until someone approves them.
    {%- endif %}
    - [ ] Merge the first release PR once PR Validation passes.
    {%- if is_public and license == 'None' %}
    - [ ] Add a license. Without one, nobody may legally use, copy, modify, or distribute this code without your permission.
    {%- endif %}
  when: false
# endregion Post-Question Computed Values

# region Locked Values
copyright_year:
  type: str
  default: "{{ copyright_year | default('%Y' | strftime) }}"
  when: false
# endregion Locked Values

# region Tasks
_tasks:
  # For an existing project, seeds knope-current-version.json from its latest vX.Y.Z
  # tag (the backfill migration shares this command), so the first release continues
  # from there instead of from 0.0.0.
  - command: *seed_version_from_tag
    when: "{{ _copier_operation == 'copy' }}"
{%- endraw %}
{%- if is_extensible %}
{%- raw %}

  # Makes nested templates work: every Template project gets an unrendered copy of
  # the parent's template/ directory, read from Copier's own clone of the parent at the
  # version being rendered. A leaf template's copy leaves out the paths gated on
  # is_template or is_extensible, since its own projects are never templates, and has
  # those gates folded out of the files it keeps. copytree only adds and overwrites, so
  # on update this also removes the files the parent deleted or renamed since the
  # previous version, which it reads from the answers file committed at HEAD.
  - command:
      - "{{ _copier_python }}"
      - -c
      - |
        import importlib.machinery, importlib.util, os, pathlib, re, shutil, subprocess, sys, tempfile
        src, answers_file, extensible = sys.argv[1:4]
        # Split so Copier doesn't read them as Jinja tags when it renders this task.
        template_only = ("{" + "% if is_template %" + "}", "{" + "% if is_extensible %" + "}")
        folder = None
        if extensible != "True":
            # A leaf's projects are always Standard, so is_template, is_standard, and
            # is_extensible get folded out of its copy; see the script's docstring.
            scripts = template_only[0] + "scripts{" + "% endif %" + "}"
            script = template_only[1] + "fold_leaf_gates.py{" + "% endif %" + "}"
            # Its file name ends in the gate, not .py, so name the loader.
            loader = importlib.machinery.SourceFileLoader(
                "fold_leaf_gates", os.path.join(src, "template", scripts, script)
            )
            folder = importlib.util.module_from_spec(
                importlib.util.spec_from_loader(loader.name, loader)
            )
            loader.exec_module(folder)


        def is_template_only(name):
            return any(gate in name for gate in template_only)


        def skip_template_only(_directory, names):
            return [n for n in names if is_template_only(n)]


        def is_stale(name):
            # In a leaf: a template-only path, or a name that still carries a
            # project-type gate (from before the template became a leaf).
            return is_template_only(name) or folder.fold(name) != name


        def local_path(path):
            # Where a parent template/ path lives in this project's copy.
            if folder is None:
                return path
            return "/".join(folder.fold(part) for part in path.split("/"))

        old = subprocess.run(
            ["git", "show", "HEAD:" + answers_file.replace("\\", "/")],
            capture_output=True, text=True,
        )
        old_ref = re.search(r"(?m)^_commit:\s*(\S+)", old.stdout) if old.returncode == 0 else None
        if old_ref:
            diff = subprocess.run(
                ["git", "-C", src, "diff", "--name-only", "--no-renames",
                 "--diff-filter=D", "-z", old_ref.group(1), "HEAD", "--", "template"],
                capture_output=True, text=True,
            )
            if diff.returncode != 0:
                print("Warning: couldn't diff the parent template from " + old_ref.group(1)
                      + "; files it deleted since then won't be removed from template/.")
            for path in map(local_path, filter(None, diff.stdout.split("\0"))):
                if os.path.isfile(path):
                    os.remove(path)
                    parent = os.path.dirname(path)
                    while parent != "template" and os.path.isdir(parent) and not os.listdir(parent):
                        os.rmdir(parent)
                        parent = os.path.dirname(parent)
        if folder and os.path.isdir("template"):
            for root, dirs, names in os.walk("template"):
                for name in [*dirs, *names]:
                    if is_stale(name):
                        path = os.path.join(root, name)
                        shutil.rmtree(path) if os.path.isdir(path) else os.remove(path)
                dirs[:] = [x for x in dirs if not is_stale(x)]
        # Fold in a staging copy, so the copy over template/ replaces the folded paths.
        with tempfile.TemporaryDirectory() as staging:
            copy = os.path.join(staging, "template")
            shutil.copytree(
                os.path.join(src, "template"), copy,
                ignore=None if folder is None else skip_template_only,
            )
            if folder:
                folder.fold_directory(pathlib.Path(copy))
            shutil.copytree(copy, "template", dirs_exist_ok=True)
      - "{{ _copier_conf.src_path }}"
      - "{{ _copier_conf.answers_file }}"
      - "{{ is_extensible }}"
    when: |-
      {%- if is_template -%}
        true
      {%- endif %}
{%- endraw %}
{%- endif %}
{%- raw %}

  # Creates GitHub Repo
  - command: >-
      gh repo create
      {% if github_org and github_org != 'None' %}{{ github_org }}/{% endif %}{{ repo_name }}
      {% if is_public %}--public{% else %}--private{% endif %}
    when: |-
      {%- if _copier_operation == 'copy' and should_create_repo and using_github -%}
        true
      {%- endif %}

  # Creates Azure DevOps Repo
  - command: >-
      az repos create
      --name {{ repo_name }}
      --org https://dev.azure.com/{{ azdo_org }}/
      --project "{{ azdo_project }}"
    when: |-
      {%- if _copier_operation == 'copy' and should_create_repo and using_azdo -%}
        true
      {%- endif %}

  # Inits Local Git Repo
  - command: git init -b main
    when: &when_copy_create_repo |-
      {%- if _copier_operation == 'copy' and should_create_repo -%}
        true
      {%- endif %}

  # Tracks all Files in Git
  - command: git add --all
    when: *when_copy_create_repo

  # Commits template files
  - command: 'git commit -m "feat: initialize project"'
    when: *when_copy_create_repo

  # Adds Git Remote
  - command: >-
      git remote add origin
      {% if using_github -%}
        https://github.com/{{ github_repo_owner }}/{{ repo_name }}.git
      {%- elif using_azdo -%}
        https://{{ azdo_org }}@dev.azure.com/{{ azdo_org }}/{{ azdo_project_encoded }}/_git/{{ repo_name }}
      {%- endif %}
    when: *when_copy_create_repo

  # Push commit to remote
  - command: git push -u origin --all
    when: *when_copy_create_repo

  # Creates Azure Pipeline for maint-auto-monthlymaintenance
  - command: >-
      az pipelines create
      --name "[{{ repo_name }}] Maint (Auto) - Monthly Maintenance"
      --repository {{ repo_name }}
      --repository-type tfsgit
      --branch main
      --yml-path .azurepipelines/maint-auto-monthlymaintenance.yml
      --skip-first-run true
      --org https://dev.azure.com/{{ azdo_org }}/
      --project "{{ azdo_project }}"
    when: &when_copy_set_repo_settings_azdo |-
      {%- if _copier_operation == 'copy' and should_set_repo_settings and using_azdo -%}
        true
      {%- endif %}

  # Creates Azure Pipeline for docs-auto-zensical
  - command: >-
      az pipelines create
      --name "[{{ repo_name }}] Docs (Auto) - Zensical Build & Commit"
      --repository {{ repo_name }}
      --repository-type tfsgit
      --branch main
      --yml-path .azurepipelines/docs-auto-zensicalcommit.yml
      --skip-first-run true
      --org https://dev.azure.com/{{ azdo_org }}/
      --project "{{ azdo_project }}"
    when: *when_copy_set_repo_settings_azdo

  # Runs the docs pipeline once, so docs-site/ exists before the first docs PR merges.
  - command: >-
      az pipelines run
      --name "[{{ repo_name }}] Docs (Auto) - Zensical Build & Commit"
      --org https://dev.azure.com/{{ azdo_org }}/
      --project "{{ azdo_project }}"
    when: *when_copy_set_repo_settings_azdo

  # Creates Azure Pipeline for test-auto-prvalidation
  - command: >-
      az pipelines create
      --name "[{{ repo_name }}] Test (Auto) - PR Validation"
      --repository {{ repo_name }}
      --repository-type tfsgit
      --branch main
      --yml-path .azurepipelines/test-auto-prvalidation.yml
      --skip-first-run true
      --org https://dev.azure.com/{{ azdo_org }}/
      --project "{{ azdo_project }}"
    when: *when_copy_set_repo_settings_azdo

  # Requires the pr_validation build to pass before a PR completes, and lets Project
  # Administrators override it (matching GitHub's admin bypass_actors entry in
  # settings.yml.jinja). `az repos policy` has no flag for the override: it's a
  # branch-level security permission, set through the raw security-namespace API
  # because `az repos` and `az devops` have no command for it. Microsoft's CLI docs
  # don't give the namespace ID, permission bit, or token format; they come from
  # https://github.com/Azure/azure-devops-cli-extension/blob/master/doc/security_tokens.md
  # and https://devblogs.microsoft.com/devops/git-repo-tokens-for-the-security-service/.
  - command:
      - "{{ _copier_python }}"
      - -c
      - |
        import json, shutil, subprocess

        ORG = "https://dev.azure.com/{{ azdo_org }}/"
        PROJECT = "{{ azdo_project }}"
        # On Windows, az is an az.cmd batch wrapper, which subprocess without a shell
        # can't find by bare name (FileNotFoundError: [WinError 2]). which() resolves
        # its path on any platform without needing shell=True.
        AZ = shutil.which("az") or "az"


        def az(*args, project=True):
            cmd = [AZ, *args, "--org", ORG]
            if project:
                cmd += ["--project", PROJECT]
            return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout


        repo_id = az(
            "repos", "show", "--repository", "{{ repo_name }}", "--query", "id", "-o", "tsv"
        ).strip()
        pipeline_id = az(
            "pipelines", "show", "--name", "[{{ repo_name }}] Test (Auto) - PR Validation",
            "--query", "id", "-o", "tsv",
        ).strip()

        subprocess.run(
            [
                AZ, "repos", "policy", "build", "create",
                "--blocking", "true",
                "--enabled", "true",
                "--branch", "main",
                "--build-definition-id", pipeline_id,
                "--display-name", "PR Validation",
                "--manual-queue-only", "false",
                "--queue-on-source-update-only", "false",
                "--valid-duration", "0",
                "--repository-id", repo_id,
                "--org", ORG,
                "--project", PROJECT,
            ],
            check=True,
        )

        project_id = az("devops", "project", "show", "--query", "id", "-o", "tsv").strip()
        groups = json.loads(az("devops", "security", "group", "list", "-o", "json"))
        descriptor = next(
            g["descriptor"]
            for g in groups["graphGroups"]
            if g["displayName"] == "Project Administrators"
        )
        # refs/heads/main, UTF-16LE hex-encoded per character: Azure DevOps's Git ACL
        # token format for a branch.
        token = f"repoV2/{project_id}/{repo_id}/refs/heads/6d00610069006e00"
        subprocess.run(
            [
                AZ, "devops", "security", "permission", "update",
                "--namespace-id", "2e9eb7ed-3c0a-47d4-87c1-0ffdd275fd87",  # Git Repositories
                "--subject", descriptor,
                "--token", token,
                "--allow-bit", "32768",  # PullRequestBypassPolicy
                "--org", ORG,
            ],
            check=True,
        )
    when: *when_copy_set_repo_settings_azdo

  # Creates Azure Pipeline for release-auto-release
  - command: >-
      az pipelines create
      --name "[{{ repo_name }}] Release (Auto) - Prepare & Publish Release"
      --repository {{ repo_name }}
      --repository-type tfsgit
      --branch main
      --yml-path .azurepipelines/release-auto-release.yml
      --skip-first-run true
      --org https://dev.azure.com/{{ azdo_org }}/
      --project "{{ azdo_project }}"
    when: *when_copy_set_repo_settings_azdo

  # Runs the release pipeline once, so the first release PR opens right away.
  - command: >-
      az pipelines run
      --name "[{{ repo_name }}] Release (Auto) - Prepare & Publish Release"
      --org https://dev.azure.com/{{ azdo_org }}/
      --project "{{ azdo_project }}"
    when: *when_copy_set_repo_settings_azdo

  # Applies .github/settings.yml with gh-settings, which mise.toml pins: the repo
  # settings, labels, branch protection ruleset, Actions settings, and, with GitHub
  # Pages, the Pages site and its environment. `mise run sync-repo-settings` reapplies
  # it after a change. Only the new project's mise.toml provides gh-settings, so this
  # runs it through `mise x`, which installs it and trusts that mise.toml.
  - command:
      - mise
      - x
      - --
      - gh-settings
      - sync
      - --yes
      - --repo
      - "{{ github_repo_owner }}/{{ repo_name }}"
    when: |-
      {%- if _copier_operation == 'copy' and using_github and repo_setup_actions != 'None' -%}
        true
      {%- endif %}

  # Reapplies the github-pages environment. gh-settings applies environments before
  # Pages, and enabling Pages restricts that environment to the default branch, which
  # would block docs publishing from a release tag. Remove this once gh-settings orders
  # environments after Pages: https://github.com/natescherer/postmodern-repo-copiertemplate/issues/1332
  - command:
      - mise
      - x
      - --
      - gh-settings
      - sync
      - --yes
      - --only
      - environments
      - --repo
      - "{{ github_repo_owner }}/{{ repo_name }}"
    when: |-
      {%- if _copier_operation == 'copy' and using_github and zensical_ghpages and repo_setup_actions != 'None' -%}
        true
      {%- endif %}

  # Enables CodeQL default setup, for public repos only: private repos need a paid
  # GitHub Advanced Security license. Right after the first push, GitHub can answer
  # 422 "Failed to toggle code scanning default setup" for a minute or so, then enables
  # it, so this retries a 422 for up to three minutes; any other error fails at once.
  - command:
      - "{{ _copier_python }}"
      - -c
      - |
        import shutil, subprocess, sys, time

        GH = shutil.which("gh") or "gh"
        ENDPOINT = "repos/{{ github_repo_owner }}/{{ repo_name }}/code-scanning/default-setup"
        for attempt in range(19):
            result = subprocess.run(
                [GH, "api", ENDPOINT, "-X", "PATCH", "-f", "state=configured"],
                capture_output=True, text=True,
            )
            if result.returncode == 0:
                sys.exit(0)
            if "HTTP 422" not in result.stderr or attempt == 18:
                sys.exit(f"Couldn't enable CodeQL default setup: {result.stderr.strip()}")
            if attempt == 0:
                print("GitHub isn't ready to enable CodeQL yet; retrying for up to 3 minutes.")
            time.sleep(10)
    when: &when_copy_public_github |-
      {%- if _copier_operation == 'copy' and is_public and using_github and repo_setup_actions != 'None' -%}
        true
      {%- endif %}

  # Lets anyone report a vulnerability privately (Security > Advisories) instead of in a
  # public issue. Public repos only: a private repo's issues are already limited to its
  # collaborators.
  - command: gh api repos/{{ github_repo_owner }}/{{ repo_name }}/private-vulnerability-reporting -X PUT
    when: *when_copy_public_github

  # Opens the setup checklist as a GitHub Issue
  - command:
      - gh
      - issue
      - create
      - --repo
      - "{{ github_repo_owner }}/{{ repo_name }}"
      - --title
      - "Template Setup Checklist"
      - --body
      - "{{ setup_checklist }}"
    when: |-
      {%- if _copier_operation == 'copy' and using_github and repo_setup_actions != 'None' -%}
        true
      {%- endif %}
# endregion Tasks

# region Messages
_message_after_copy: |-
  {%- if using_azdo or (using_github and repo_setup_actions == 'None') %}

  Setup checklist:
  {{ setup_checklist }}

  {% endif -%}
  {%- if using_github and repo_setup_actions == 'None' -%}
    Once the repo exists, run `mise run sync-repo-settings` to apply .github/settings.yml (labels, merge options, branch protection, and more), or apply the settings by hand: {{ parent_template_docs_url }}reference/manual-repo-settings{{ parent_template_docs_suffix }}

  {% endif -%}
  {%- if using_azdo and not should_set_repo_settings -%}
    Repo setup was skipped, so the pipelines and the PR Validation build policy don't exist yet. Set them up by hand: {{ parent_template_docs_url }}reference/manual-repo-settings{{ parent_template_docs_suffix }}

  {% endif -%}
  {%- if using_github -%}
  Before CI works, add these GitHub Actions secrets (Settings > Secrets and variables > Actions):
    - APPRISE_URL
  {%- if code_coverage %}
    - CODECOV_TOKEN
  {%- endif %}
  Run `mise run provision-secrets`, or see {{ parent_template_docs_url }}reference/token-permissions{{ parent_template_docs_suffix }} to set them by hand.
  {%- elif using_azdo -%}
  Before CI works, set these as secret variables on the pipelines that use them:
    - APPRISE_URL
    - GITHUB_COM_TOKEN
  Run `mise run provision-secrets`, or see {{ parent_template_docs_url }}reference/token-permissions{{ parent_template_docs_suffix }} to set them by hand.
  {%- endif %}

_message_after_update: |-
  {%- if lifecycle == 'Stable' and current_knope_version_is_pre_1 -%}
  This project's lifecycle is 'Stable', but it hasn't released 1.0.0. This update pins the
  next release to 1.0.0 in .config/knope-release-override.json; once it's merged to main, the
  release PR proposes 1.0.0.
  {%- endif %}
  {%- set changesets = (('"' ~ _copier_python ~ '" -c "import glob, os, sys; print(chr(10).join(glob.glob(os.path.join(sys.argv[1], \'.changeset\', \'template-update-*.md\'))))" "' ~ _copier_conf.dst_path ~ '"') | shell()) -%}
  {%- if changesets.strip() %}

  The '.changeset' folder has new changesets describing upstream template changes. Some (such as
  platform-specific fixes or template-internal tooling) may not apply here; delete those before
  merging.
  {%- endif %}
# endregion Messages
{%- endraw %}
