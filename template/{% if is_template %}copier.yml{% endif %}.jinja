{%- macro double_quote_for_yaml_if_needed(value) -%}
  {%- set _auto = value | to_yaml -%}
  {%- if _auto.startswith("'") -%}
    {{- value | to_yaml(default_style='"') | trim -}}
  {%- else -%}
    {{- value -}}
  {%- endif -%}
{%- endmacro -%}
{#- This project's own docs pages live at docs_base() + page path + docs_suffix(). Points
    at the repo's rendered Markdown when there's no hosted site, since a committed
    docs-site/ isn't browsable from the repo host. -#}
{%- macro docs_base() -%}
  {%- if zensical_ghpages -%}
    https://{{ github_repo_owner }}.github.io/{{ repo_name }}/latest/
  {%- elif using_github -%}
    https://github.com/{{ github_repo_owner }}/{{ repo_name }}/blob/main/docs/
  {%- elif using_azdo -%}
    https://dev.azure.com/{{ azdo_org }}/{{ azdo_project_encoded }}/_git/{{ repo_name }}?path=/docs/
  {%- endif -%}
{%- endmacro -%}
{%- macro docs_suffix() -%}
  {{- '/' if zensical_ghpages else '.md' -}}
{%- endmacro -%}
