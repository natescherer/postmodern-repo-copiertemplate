zensical_ghpages:
  type: bool
  default: |-
    {%- if zensical_target == 'GitHub Pages' -%}
      true
    {%- endif %}
  when: false

zensical_repo:
  type: bool
  default: |-
    {%- if zensical_target == 'docs-site Directory in Repo' or using_azdo -%}
      true
    {%- endif %}
  when: false

# Where this project's own docs pages are published: `<url><page><suffix>`. A
# section index page is `<url><section>/index.html` under either target.
docs_url:
  type: str
  default: |-
    {%- if zensical_ghpages -%}
      https://{{ github_repo_owner }}.github.io/{{ repo_name }}/latest/
    {%- else -%}
      docs-site/
    {%- endif %}
