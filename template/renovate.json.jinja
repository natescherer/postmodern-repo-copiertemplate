{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "extends": [
    "config:recommended"
    {%- if is_template or using_github %},
    "helpers:pinGitHubActionDigests"
    {%- endif %}
  ],
  "schedule": [
    "* 18 1 * *"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "commitBody": {% raw %}"Dependency-Update: {{{replace '^[^:]*: ' '' commitMessage}}}"{% endraw %},
  "prFooter": {% raw %}"Dependency-Update: {{{replace '^[^:]*: ' '' prTitle}}}"{% endraw %},
  {%- if is_template or (is_standard and using_azdo) %}
  "azure-pipelines": {
    "enabled": true,
    "managerFilePatterns": [
      {%- if is_template %}
      {% raw %}"/(^|/)(?:{%.*%})?\\.azurepipelines(?:{%.*%})?/.+\\.ya?ml(?:{%.*%})?(?:\\.jinja)?$/"{% endraw %}
      {%- else %}
      "/(^|/)\\.azurepipelines/.+\\.ya?ml$/"
      {%- endif %}
    ]
  },
  {%- endif %}
  "copier": {
    "description": "Copier template updates are handled by the Monthly Maintenance workflow or pipeline's Copier Update Check job",
    "enabled": false
  },
  {%- if is_template %}
  "github-actions": {
    "managerFilePatterns": [
      {% raw %}"/(^|/)(?:{%.*%})?\\.github(?:{%.*%})?/workflows/.+\\.ya?ml(?:{%.*%})?(?:\\.jinja)?$/"{% endraw %}
    ]
  },
  {%- endif %}
  "packageRules": [
    {#- These groups pair a tool's pin in template/ (found by the custom managers
        below) with its pin in the project's own rendered files (found by Renovate's
        built-in managers), so both update together; a non-template project has just
        one of each. #}
    {%- if is_template %}
    {
      "description": "Group actionlint",
      "matchPackageNames": [
        "actionlint",
        "rhysd/actionlint"
      ],
      "groupName": "actionlint"
    },
    {
      "description": "Group apprise",
      "matchPackageNames": [
        "apprise",
        "pipx:apprise"
      ],
      "groupName": "apprise"
    },
    {
      "description": "Group cli",
      "matchPackageNames": [
        "cli/cli",
        "aqua:cli/cli"
      ],
      "groupName": "cli"
    },
    {
      "description": "Group committed",
      "matchPackageNames": [
        "committed",
        "crate-ci/committed"
      ],
      "groupName": "committed"
    },
    {
      "description": "Group copier",
      "matchPackageNames": [
        "copier",
        "pipx:copier"
      ],
      "groupName": "copier"
    },
    {
      "description": "Group knope",
      "matchPackageNames": [
        "knope-dev/knope"
      ],
      "groupName": "knope"
    },
    {
      "description": "Group lychee",
      "matchPackageNames": [
        "lychee",
        "lycheeverse/lychee"
      ],
      "groupName": "lychee"
    },
    {
      "description": "Group prek",
      "matchPackageNames": [
        "j178/prek",
        "aqua:j178/prek"
      ],
      "groupName": "prek"
    },
    {
      "description": "Group renovate",
      "matchPackageNames": [
        "renovate",
        "npm:renovate"
      ],
      "groupName": "renovate"
    },
    {
      "description": "Group ruff",
      "matchPackageNames": [
        "ruff",
        "astral-sh/ruff"
      ],
      "groupName": "ruff"
    },
    {
      "description": "Group rumdl",
      "matchPackageNames": [
        "rumdl",
        "rvben/rumdl"
      ],
      "groupName": "rumdl"
    },
    {
      "description": "Group ryl",
      "matchPackageNames": [
        "owenlamont/ryl",
        "aqua:owenlamont/ryl"
      ],
      "groupName": "ryl"
    },
    {
      "description": "Group shellcheck",
      "matchPackageNames": [
        "shellcheck",
        "koalaman/shellcheck"
      ],
      "groupName": "shellcheck"
    },
    {
      "description": "Group tombi",
      "matchPackageNames": [
        "tombi-toml/tombi",
        "aqua:tombi-toml/tombi"
      ],
      "groupName": "tombi"
    },
    {
      "description": "Group typos",
      "matchPackageNames": [
        "crate-ci/typos",
        "aqua:crate-ci/typos"
      ],
      "groupName": "typos"
    },
    {
      "description": "Group uv",
      "matchPackageNames": [
        "uv",
        "astral-sh/uv"
      ],
      "groupName": "uv"
    },
    {%- endif %}
    {#- zensical is pinned twice in any GitHub Pages project: as a mise tool and in
        mise.ci.toml's uvx_args, which is also where mike is a git-sourced mise tool. #}
    {%- if is_template or zensical_ghpages %}
    {
      "description": "Group zensical",
      "matchPackageNames": [
        "zensical",
        "pipx:zensical"
      ],
      "groupName": "zensical"
    },
    {
      "description": "Leave git-sourced pipx tools to their custom manager, whose loose versioning can compare fork tags",
      "matchManagers": ["mise"],
      "matchDepNames": ["/^pipx:git\\+/"],
      "enabled": false
    }{% if is_template %},{% endif %}
    {%- endif %}
    {%- if is_template or using_azdo %}
    {
      "description": "Use standard major version numbers for Azure Pipelines",
      "matchDatasources": ["azure-pipelines-tasks"],
      "extractVersion": "^(?<version>\\d+)"
    }
    {%- endif %}
  ],
  "customManagers": [
    {%- if is_template %}
    {
      "description": "Manager for simple mise tools",
      "customType": "regex",
      "managerFilePatterns": [
        {% raw %}"/mise\\..*toml(?:{%.*%})?\\.jinja/"{% endraw %}
      ],
      "matchStrings": [
        {% raw %}"{#[-]? renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?(?: registryUrl=(?<registryUrl>[^\\s]+?))?\\s*-?#}\\s+[A-Za-z0-9_\\-\"':/]+\\s?=\\s?[\"'](?<currentValue>[^\"']*)[\"'].*"{% endraw %}
      ],
      "versioningTemplate": {% raw %}"{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"{% endraw %}
    },
    {
      "description": "Manager for the knope mise tool pin: knope-dev/knope tags each crate separately (knope/vX.Y.Z), which the generic \"simple mise tools\" manager can't filter; extractVersionTemplate keeps only knope's tags",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "knope-dev/knope",
      "extractVersionTemplate": "^knope/v(?<version>.*)$",
      "managerFilePatterns": [
        {% raw %}"/mise\\..*toml(?:{%.*%})?\\.jinja/"{% endraw %}
      ],
      "matchStrings": [
        "\"github:knope-dev/knope\"\\s*=\\s*\"knope/v(?<currentValue>[^\"]*)\""
      ],
      "versioningTemplate": "semver"
    },
    {
      "description": "Manager for a Template project's own copier.yml min_copier_version pin",
      "customType": "regex",
      "managerFilePatterns": [
        {% raw %}"/(^|/)(?:{%.*%})?copier\\.yml(?:{%.*%})?(?:\\.jinja)?$/"{% endraw %}
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-.]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?\\s*\\n_min_copier_version:\\s*[\"'](?<currentValue>[^\"']*)[\"']"
      ],
      "versioningTemplate": {% raw %}"{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"{% endraw %}
    },
    {
      "description": "Manager for pipx tools with options",
      "customType": "regex",
      "datasourceTemplate": "pypi",
      "managerFilePatterns": [
        {% raw %}"/mise\\..*toml(?:{%.*%})?\\.jinja/"{% endraw %}
      ],
      "matchStrings": [
        "\\[tools\\.\"?pipx:(?<depName>[A-Za-z0-9_.-]+)\"?\\]\\sversion = \"(?<currentValue>[^\\s]*)\""
      ],
      "versioningTemplate": "pep440"
    },
    {%- endif %}
    {
      "description": "Manager for git-sourced pipx tools, as a mise tool or in another tool's uvx_args; loose versioning, since a fork tag like 2.2.0+zensical-0.1.0 keeps its real version in build metadata, which semver ignores",
      "customType": "regex",
      "managerFilePatterns": [
        {%- if is_template %}
        {% raw %}"/(^|/)(?:{%.*%})?mise(\\.\\w+)*\\.toml(?:{%.*%})?(\\.jinja)?$/"{% endraw %}
        {%- else %}
        "/(^|/)mise(\\.\\w+)*\\.toml$/"
        {%- endif %}
      ],
      "matchStrings": [
        "\\[tools\\.\"pipx:git\\+https://github\\.com/(?<packageName>[^/]+/[^\"]+)\\.git\"\\]\\s+version = \"(?<currentValue>[^\"]+)\"",
        "--with git\\+https://github\\.com/(?<packageName>[^/]+/[^@\\s\"]+?)\\.git@(?<currentValue>[^\\s\"]+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose"
    },
    {%- if is_template or using_azdo %}
    {
      "description": "Manager for the mise version pin in Azure Pipelines' install step, plus mise-action's in .jinja workflows (which the github-actions manager can't parse as YAML)",
      "customType": "regex",
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "extractVersionTemplate": "^v(?<version>.*)$",
      "managerFilePatterns": [
        {%- if is_template %}
        {% raw %}"/(^|/)(?:{%.*%})?\\.azurepipelines(?:{%.*%})?/.+\\.ya?ml(?:{%.*%})?(?:\\.jinja)?$/",
        "/(^|/)(?:{%.*%})?\\.github(?:{%.*%})?/workflows/.+\\.ya?ml(?:{%.*%})?\\.jinja$/"{% endraw %}
        {%- else %}
        "/(^|/)\\.azurepipelines/.+\\.ya?ml$/"
        {%- endif %}
      ],
      "matchStrings": [
        "MISE_VERSION=v(?<currentValue>[^\\s]+)"{% if is_template %},
        "version: (?<currentValue>\\d+\\.\\d+\\.\\d+) # jdx/mise"{% endif %}
      ],
      "versioningTemplate": "semver"
    },
    {%- endif %}
    {
      "description": "Manager for pipx tool dependencies",
      "customType": "regex",
      "datasourceTemplate": "pypi",
      "managerFilePatterns": [
        {%- if is_template %}
        "/mise\\..*toml(?:\\.jinja)?/"
        {%- else %}
        "/mise\\..*toml/"
        {%- endif %}
      ],
      "matchStrings": [
        ".*?(--with\\s(?<depName>.+?)(\\[\\S+])*==(?<currentValue>[^\"\\s{]*))"
      ],
      "versioningTemplate": "pep440"
    }{% if is_template %},
    {
      "description": "Manager for npm-backed mise tools with options: the npm counterpart of \"Manager for pipx tools with options\", whose datasource is fixed to pypi",
      "customType": "regex",
      "datasourceTemplate": "npm",
      "managerFilePatterns": [
        "/mise\\..*toml(?:\\.jinja)?/"
      ],
      "matchStrings": [
        "\\[tools\\.\"?npm:(?<depName>[A-Za-z0-9_.-]+)\"?\\]\\sversion = \"(?<currentValue>[^\\s]*)\""
      ],
      "versioningTemplate": "npm"
    }
    {%- endif %}
  ]
}
