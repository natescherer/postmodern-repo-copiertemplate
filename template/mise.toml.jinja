{# renovate: datasource=github-releases depName=jdx/mise -#}
min_version = "2026.8.13"

[hooks]
{% raw %}postinstall = [
  "{% set is_in_ci = get_env(name='CI', default='') %}{% if is_in_ci %}echo 'Not setting up git hooks as mise is running in CI!'{% else %}prek install -f -c .config/prek.toml{% endif %}",
]{% endraw %}

[env]
# Keep tool caches under .cache/ instead of the repo root.
PYTHONPYCACHEPREFIX = ".cache/pycache"
RUMDL_CACHE_DIR = ".cache/rumdl"
{%- if is_template %}
PYTEST_ADDOPTS = "-o cache_dir=.cache/pytest -n auto"
RUFF_CACHE_DIR = ".cache/ruff"
{%- endif %}

[tasks.copier-update]
# Runs the newest Copier, not the one pinned below: only the template version being
# updated to knows the Copier it needs (_min_copier_version), so the pin from this
# project's current version can fall short of it. jinja2-shell-extension, which the
# template's copier.yml loads, is unpinned for the same reason: a newer template can
# need a newer extension. `@latest` and --refresh make uvx resolve both afresh instead
# of reusing a cached environment.
run = "uvx --refresh --from copier@latest --with jinja2-shell-extension copier update --answers-file .config/copier-answers.yml --skip-answered --trust"

[tasks.set-lifecycle]
# Asks only the `lifecycle` question again (--ask overrides --skip-answered for it,
# with the current value preselected), and --vcs-ref=:current: keeps the installed
# template version, so no template update comes with it. _min_copier_version covers
# both flags.
run = "copier update --answers-file .config/copier-answers.yml --skip-answered --trust --vcs-ref=:current: --ask lifecycle"

[tasks.docs-server]
run = "zensical serve"

[tasks.provision-secrets]
# Opt-in, and separate from _tasks on purpose; see
# {{ docs_url }}reference/token-permissions{{ docs_page_suffix }}. `raw` hands
# the terminal to gh and az, so each CLI's own masked prompt reads the value directly;
# it never appears in a command-line argument, mise's logs, or a script.
raw = true
run = [
{%- if using_github %}
  "gh secret set APPRISE_URL",
{%- if code_coverage %}
  "gh secret set CODECOV_TOKEN",
{%- endif %}
{%- elif using_azdo %}
  "az pipelines variable create --name APPRISE_URL --pipeline-name \"[{{ repo_name }}] Maint (Auto) - Monthly Maintenance\" --secret true --allow-override true --org https://dev.azure.com/{{ azdo_org }}/ --project \"{{ azdo_project }}\"",
  "az pipelines variable create --name APPRISE_URL --pipeline-name \"[{{ repo_name }}] Docs (Auto) - Zensical Build & Commit\" --secret true --allow-override true --org https://dev.azure.com/{{ azdo_org }}/ --project \"{{ azdo_project }}\"",
  "az pipelines variable create --name GITHUB_COM_TOKEN --pipeline-name \"[{{ repo_name }}] Maint (Auto) - Monthly Maintenance\" --secret true --allow-override true --org https://dev.azure.com/{{ azdo_org }}/ --project \"{{ azdo_project }}\"",
  "az pipelines variable create --name GITHUB_COM_TOKEN --pipeline-name \"[{{ repo_name }}] Docs (Auto) - Zensical Build & Commit\" --secret true --allow-override true --org https://dev.azure.com/{{ azdo_org }}/ --project \"{{ azdo_project }}\"",
  "az pipelines variable create --name GITHUB_COM_TOKEN --pipeline-name \"[{{ repo_name }}] Release (Auto) - Prepare & Publish Release\" --secret true --allow-override true --org https://dev.azure.com/{{ azdo_org }}/ --project \"{{ azdo_project }}\"",
  "az pipelines variable create --name GITHUB_COM_TOKEN --pipeline-name \"[{{ repo_name }}] Test (Auto) - PR Validation\" --secret true --allow-override true --org https://dev.azure.com/{{ azdo_org }}/ --project \"{{ azdo_project }}\"",
{%- endif %}
]

[tasks.renovate-lookup]
# Runs every Renovate manager over the working tree without pushing or opening
# anything; the debug log's "packageFiles with updates" entry lists what each one
# detected. Its tools are task-scoped, so they only install when this task runs.
env = { LOG_LEVEL = "debug", RENOVATE_PLATFORM = "local", RENOVATE_DRY_RUN = "lookup" }
run = "renovate"

[tasks.renovate-lookup.tools]
{#- renovate: datasource=node-version depName=node versioning=node #}
node = "24.22.0"

[tasks.renovate-lookup.tools."npm:renovate"]
{#- renovate: datasource=npm depName=renovate #}
version = "44.158.1"
# @yarnpkg/libzip@3.2.2 (a renovate transitive dependency) lost the provenance
# attestation 3.2.0 had, so mise's trust policy refuses it; remove once
# https://github.com/yarnpkg/berry/issues/7182 is fixed.
trust_policy_excludes = ["@yarnpkg/libzip@3.2.2"]
{%- if using_github %}

[tasks.sync-repo-settings]
# Applies .github/settings.yml to the repo with gh-settings, showing the changes and
# asking before it makes them; `mise x -- gh-settings plan` only shows them. Needs
# admin access to the repo through `gh auth login`. `raw` hands the terminal to
# gh-settings for its prompt.
raw = true
run = "gh-settings sync"
{%- endif %}
{%- if using_azdo %}

[tasks.migrate-azdo-pipeline-names]
# Repoints existing pipeline registrations after an update renames files under
# .azurepipelines/. It's a task, not a _tasks entry, because _tasks runs only on
# `copier copy`; see the script's docstring.
run = "python .azurepipelines/migrate_pipeline_names.py"
{%- endif %}
{%- if is_template %}

[tasks.test]
run = "pytest tests/"

[tasks.template-docs-server]
# Previews template/'s docs with a real Zensical build under every distinct
# ANSWER_MATRIX entry: no single answer set renders the whole docs/ tree, since both
# content and file paths depend on the answers. See the script's docstring. It runs
# through `uv run` so its PEP 723 header can supply rich, tomlkit, and watchdog.
run = "uv run scripts/template_docs_server.py"

[tasks.integration-test-gh]
# Verifies a release candidate on main before a release. Creates two test repos from
# this template and runs every automated check against Repo A, a copy at HEAD. Repo B
# is a copy at the last stable tag: update it to HEAD yourself, as the runbook's
# Repo B section says, then check it with
# `mise run integration-test-verify-update-gh`. Both repos stay
# for inspection; delete them with `mise run integration-test-cleanup-gh`. See
# {{ docs_url }}maintaining/integration-testing/index.html and
# {{ docs_url }}maintaining/integration-testing/runbook-github{{ docs_page_suffix }}.
run = "python scripts/integration_test_github.py --source {% if using_github %}https://github.com/{{ github_repo_owner }}/{{ repo_name }}{% elif using_azdo %}git+https://dev.azure.com/{{ azdo_org }}/{{ azdo_project_encoded }}/_git/{{ repo_name }}{% endif %} --repo-prefix {{ repo_name }}{% if not is_extensible %} --leaf{% endif %}"

[tasks.integration-test-verify-update-gh]
# Run after updating Repo B by hand (see the "Repo B" section of
# {{ docs_url }}maintaining/integration-testing/runbook-github{{ docs_page_suffix }}).
# Checks that the update brought in current content, left no conflict markers, and that
# PR Validation still works. It verifies the newest run's Repo B, found from its local
# clone, unless --repo and --local-path name another.
usage = '''
flag "--repo <repo>" help="owner/repo of the already-updated Repo B"
flag "--local-path <path>" help="Local clone path printed when Repo B was created"
'''
run = "python scripts/integration_test_github.py --verify-update --repo-prefix {{ repo_name }}"

[tasks.integration-test-cleanup-gh]
# Deletes every repo integration-test-gh created, including those of a run that
# stopped partway, after listing them and asking.
run = "python scripts/integration_test_github.py --cleanup --repo-prefix {{ repo_name }}"

[tasks.integration-test-azdo]
{%- set org_default = azdo_org if using_azdo else '' %}
{%- set project_default = azdo_project if using_azdo else '' %}
# Verifies a release candidate on main before a release. Creates two test repos from
# this template and runs every automated check against Repo A, a copy at HEAD. Repo B
# is a copy at the last stable tag: update it to HEAD yourself, as the runbook's
# Repo B section says, then check it with
# `mise run integration-test-verify-update-azdo`. Both repos stay for inspection;
# delete them with `mise run integration-test-cleanup-azdo`. See
# {{ docs_url }}maintaining/integration-testing/index.html and
# {{ docs_url }}maintaining/integration-testing/runbook-azdo{{ docs_page_suffix }}.
#
# --org and --project default to INTEGRATION_TEST_AZDO_ORG and
# INTEGRATION_TEST_AZDO_PROJECT, which you can set once in mise.local.toml's
# [env]{% if using_azdo %}, and otherwise to this project's own org and project{% endif %}.
# Or pass them, as in `mise run integration-test-azdo --org myorg --project myproject`.
# The `usage` field, not the deprecated option() function, passes them to the script
# as environment variables (usage_org, usage_project), which works the same in any
# shell and fails clearly when a required value is missing.
usage = '''
flag "--org <org>" help="Azure DevOps organization" env="INTEGRATION_TEST_AZDO_ORG"{% if org_default %} default="{{ org_default }}"{% endif %}
flag "--project <project>" help="Azure DevOps project" env="INTEGRATION_TEST_AZDO_PROJECT"{% if project_default %} default="{{ project_default }}"{% endif %}
'''
run = "python scripts/integration_test_azdo.py --source {% if using_github %}https://github.com/{{ github_repo_owner }}/{{ repo_name }}{% elif using_azdo %}git+https://dev.azure.com/{{ azdo_org }}/{{ azdo_project_encoded }}/_git/{{ repo_name }}{% endif %} --repo-prefix {{ repo_name }}{% if not is_extensible %} --leaf{% endif %}"

[tasks.integration-test-verify-update-azdo]
# Run after updating Repo B by hand (see the "Repo B" section of
# {{ docs_url }}maintaining/integration-testing/runbook-azdo{{ docs_page_suffix }}).
# Checks that the update brought in current content, left no conflict markers, renamed
# pipelines in place, and that PR Validation still works. It verifies the newest run's
# Repo B, found from its local clone, which also names its org and project, unless
# --repo and --local-path name another.
usage = '''
flag "--org <org>" help="Azure DevOps organization" env="INTEGRATION_TEST_AZDO_ORG"{% if org_default %} default="{{ org_default }}"{% endif %}
flag "--project <project>" help="Azure DevOps project" env="INTEGRATION_TEST_AZDO_PROJECT"{% if project_default %} default="{{ project_default }}"{% endif %}
flag "--repo <repo>" help="Name of the already-updated Repo B"
flag "--local-path <path>" help="Local clone path printed when Repo B was created"
'''
run = "python scripts/integration_test_azdo.py --verify-update --repo-prefix {{ repo_name }}"

[tasks.integration-test-cleanup-azdo]
# Deletes every repo integration-test-azdo created, and their pipelines, including
# those of a run that stopped partway, after listing them and asking. --org and
# --project work as in integration-test-azdo.
usage = '''
flag "--org <org>" help="Azure DevOps organization" env="INTEGRATION_TEST_AZDO_ORG"{% if org_default %} default="{{ org_default }}"{% endif %}
flag "--project <project>" help="Azure DevOps project" env="INTEGRATION_TEST_AZDO_PROJECT"{% if project_default %} default="{{ project_default }}"{% endif %}
'''
run = "python scripts/integration_test_azdo.py --cleanup --repo-prefix {{ repo_name }}"
{%- endif %}

[tools]
# Backends
{#- renovate: datasource=python-version depName=python versioning=python #}
python = "3.15.0" # Used by copier
{#- renovate: datasource=github-releases depName=astral-sh/uv #}
uv = "0.13.1" # Used by pipx tools
# Tools
{%- if is_template or using_github %}
{#- Template projects need this on Azure DevOps too: copy-template-files copies all of
   template/, GitHub workflows included, whatever this project's developer_platform. #}
{#- renovate: datasource=github-releases depName=rhysd/actionlint #}
actionlint = "1.7.12"
{%- endif %}
{%- if using_github %}
{#- Used by copier.yml's _tasks for repo setup. It isn't available during the
   questions (this file doesn't exist yet), so repo_setup_actions' validator checks
   whatever gh is on PATH. #}
{#- renovate: datasource=github-releases depName=cli/cli #}
"aqua:cli/cli" = "2.102.0"
{#- Applies .github/settings.yml, from copier.yml's _tasks and `mise run
   sync-repo-settings`. Its own docs install it as a gh extension, but its release
   binaries run the same way, authenticating through `gh api`. #}
{#- renovate: datasource=github-releases depName=noirbizarre/gh-settings #}
"github:noirbizarre/gh-settings" = "0.3.0"
{%- endif %}
{#- Used by copier.yml's _tasks and the release workflows and pipelines. It uses the
   github backend because ubi is deprecated in mise and knope isn't in the aqua
   registry. knope-dev/knope tags each crate separately ("knope/vX.Y.Z"), which the
   generic "simple mise tools" manager can't filter, so renovate.json.jinja's "Manager
   for the knope mise tool pin" tracks it. There's no `renovate:` marker here, since
   the generic manager would match it too. #}
"github:knope-dev/knope" = "knope/v0.23.0"
{#- renovate: datasource=github-releases depName=crate-ci/typos #}
"aqua:crate-ci/typos" = "1.51.1"
{#- renovate: datasource=github-releases depName=j178/prek #}
"aqua:j178/prek" = "0.5.5"
{#- renovate: datasource=github-releases depName=owenlamont/ryl #}
"aqua:owenlamont/ryl" = "0.25.1"
{#- renovate: datasource=github-releases depName=tombi-toml/tombi #}
"aqua:tombi-toml/tombi" = "1.8.4"
{#- renovate: datasource=github-releases depName=crate-ci/committed #}
committed = "1.1.11"
{#- renovate: datasource=github-releases depName=lycheeverse/lychee extractVersion=^lychee-v(?<version>.*)$ #}
lychee = "0.24.2"
{%- if is_template %}
{#- renovate: datasource=github-releases depName=astral-sh/ruff #}
ruff = "0.17.0"
{%- endif %}
{#- renovate: datasource=github-releases depName=rvben/rumdl #}
rumdl = "0.2.79"
{#- renovate: datasource=github-releases depName=koalaman/shellcheck #}
shellcheck = "0.11.0"

[tools."pipx:copier"]
version = "9.19.1"
uvx_args = "--with jinja2-shell-extension==2.1.1"
{%- if is_template %}

[tools."pipx:pytest"]
version = "9.1.1"
# pytest-github-actions-annotate-failures and pytest-azurepipelines report failures and
# warnings as platform annotations (::error:: on GitHub, ##vso[task.logissue] on Azure
# DevOps), detecting the CI from the environment it sets.
uvx_args = "--with pyyaml==6.0.3 --with jinja2==3.1.6 --with jinja2-ansible-filters==1.3.2 --with pytest-xdist==3.8.0{% if using_github %} --with pytest-github-actions-annotate-failures==0.4.2{% elif using_azdo %} --with pytest-azurepipelines==1.0.5{% endif %}"
{%- endif %}

[tools."pipx:zensical"]
version = "0.0.71"
uvx_args = "--with git+https://github.com/squidfunk/mike.git@2.2.0+zensical-0.1.0"
