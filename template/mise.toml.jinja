[hooks]
{% raw %}postinstall = [
  "{% set is_in_ci = get_env(name='CI', default='') %}{% if is_in_ci %}echo 'Not setting up git hooks as mise is running in CI!'{% else %}prek install -f -c .config/prek.toml{% endif %}",
]{% endraw %}

[settings]
experimental = true # Needed for hooks as of v2025.6.2

[env]
# Centralize tool caches under .cache/ instead of scattering them across the repo root.
PYTHONPYCACHEPREFIX = ".cache/pycache"
RUMDL_CACHE_DIR = ".cache/rumdl"
{%- if is_template %}
PYTEST_ADDOPTS = "-o cache_dir=.cache/pytest"
RUFF_CACHE_DIR = ".cache/ruff"
{%- endif %}

[tasks.copier-update]
run = "copier update --answers-file .config/copier-answers.yml --skip-answered --trust"

[tasks.docs-server]
run = "zensical serve"
{%- if is_template %}

[tasks.test]
run = "pytest tests/"

[tasks.integration-test-gh]
# Same script maint-integration_test.yml runs in CI (--cleanup added there) -- see
# that file for what this actually verifies and why. Repo is left in place here by
# default so it can be inspected; pass --cleanup yourself to delete it.
run = 'python scripts/integration_test_github.py --source https://github.com/{{ github_repo_owner }}/{{ repo_name }} --vcs-ref={% raw %}{{option(name="branch",default="HEAD")}}{% endraw %} --repo-prefix {{ repo_name }}'

[tasks.integration-test-azdo]
{%- set org_default = azdo_org if using_azdo else '' %}
{%- set project_default = azdo_project if using_azdo else '' %}
# Same script maint-integration_test.yml runs in CI (--cleanup added there) -- see
# that file for what this actually verifies and why. Repo is left in place here by
# default so it can be inspected; pass --cleanup yourself to delete it. --org/--project
# default to this project's own Azure DevOps org/project when using_azdo, otherwise
# there's no natural default and they must be passed explicitly, e.g.
# `mise run integration-test-azdo -- --org myorg --project myproject`.
run = 'python scripts/integration_test_azdo.py --source {% if using_github %}https://github.com/{{ github_repo_owner }}/{{ repo_name }}{% elif using_azdo %}git+https://dev.azure.com/{{ azdo_org }}/{{ azdo_project_encoded }}/_git/{{ repo_name }}{% endif %} --vcs-ref={% raw %}{{option(name="branch",default="HEAD")}}{% endraw %} --repo-prefix {{ repo_name }} --org {% raw %}{{option(name="org"{% endraw %}{% if org_default %}, default="{{ org_default }}"{% endif %}{% raw %})}}{% endraw %} --project "{% raw %}{{option(name="project"{% endraw %}{% if project_default %}, default="{{ project_default }}"{% endif %}{% raw %})}}{% endraw %}"'
{%- endif %}

[tools]
# Backends
{#- renovate: datasource=python-version depName=python versioning=python #}
python = "3.14.7" # Used by copier
{#- renovate: datasource=github-releases depName=astral-sh/uv #}
uv = "0.12.2" # Used by pipx tools
# Tools
{%- if is_template or using_github %}
{#- is_template needs this even on Azure DevOps: copy-template-files embeds a full,
   unrendered copy of template/ (including its .github/workflows/*.yml) for any child
   template to use, regardless of *this* project's own developer_platform. #}
{#- renovate: datasource=github-releases depName=rhysd/actionlint #}
actionlint = "1.7.12"
{%- endif %}
{%- if using_github %}
{#- Used by _tasks in copier.yml for repo creation/setup. Note this doesn't help during
   the questionnaire itself (this file doesn't exist yet at that point) -- the
   developer_platform question's validator checks whatever gh is already on PATH. #}
{#- renovate: datasource=github-releases depName=cli/cli #}
"aqua:cli/cli" = "2.97.0"
{%- endif %}
{#- renovate: datasource=github-releases depName=crate-ci/typos #}
"aqua:crate-ci/typos" = "1.49.0"
{#- renovate: datasource=github-releases depName=j178/prek #}
"aqua:j178/prek" = "0.4.12"
{#- renovate: datasource=github-releases depName=owenlamont/ryl #}
"aqua:owenlamont/ryl" = "0.21.0"
{#- renovate: datasource=github-releases depName=tombi-toml/tombi #}
"aqua:tombi-toml/tombi" = "1.2.6"
{#- renovate: datasource=github-releases depName=crate-ci/committed #}
committed = "1.1.11"
{#- renovate: datasource=github-releases depName=lycheeverse/lychee #}
lychee = "0.15.1"
{%- if is_template %}
{#- renovate: datasource=github-releases depName=astral-sh/ruff #}
ruff = "0.16.1"
{%- endif %}
{#- renovate: datasource=github-releases depName=rvben/rumdl #}
rumdl = "0.2.52"
{#- renovate: datasource=github-releases depName=koalaman/shellcheck #}
shellcheck = "0.11.0"

[tools."pipx:copier"]
version = "9.17.1"
uvx_args = "--with jinja2-shell-extension==2.1.1"
{%- if is_template %}

[tools."pipx:pytest"]
version = "9.1.1"
# pytest-github-actions-annotate-failures / pytest-azurepipelines surface pytest
# failures and warnings as native platform annotations (::warning::/::error:: on
# GitHub, ##vso[task.logissue] on Azure DevOps) with zero config -- they auto-detect
# their CI via the env vars each platform already sets.
uvx_args = "--with pyyaml==6.0.3 --with jinja2==3.1.6 --with jinja2-ansible-filters==1.3.2{% if using_github %} --with pytest-github-actions-annotate-failures==0.4.2{% elif using_azdo %} --with pytest-azurepipelines==1.0.5{% endif %}"
{%- endif %}

[tools."pipx:zensical"]
version = "0.0.53"
uvx_args = "--with git+https://github.com/squidfunk/mike.git@2.2.0+zensical-0.1.0"
