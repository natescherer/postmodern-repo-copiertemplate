{
  "[jinja-json]": {
    "editor.tabSize": 2
  },
  "[jinja-md]": {
    "editor.tabSize": 2
  },
  "[jinja-toml]": {
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.tabSize": 2
  },
  "files.associations": {
    "**/.azurepipelines/*.yml": "azure-pipelines",
    "**LICENSE*.jinja": "jinja",
    "**.all-contributorsrc*.jinja": "jinja-json",
    "**.json*.jinja": "jinja-json",
    "**.md*.jinja*": "jinja-md",
    "copier.yml": "jinja-yaml",
    "**.y*ml*.jinja": "jinja-yaml",
    "**.toml*.jinja": "jinja-toml",
    "**.json[{]% endif %[}]": "json",
    "**.md[{]% endif %[}]": "markdown",
    "**.y*ml[{]% endif %[}]": "yaml",
    "**.py[{]% endif %[}]": "python",
    "**.toml[{]% endif %[}]": "toml"
  },
  "maptz.regionfolder": {
    "[jinja-yaml]": {
      "foldStart": "# region [NAME]",
      "foldStartRegex": "#\\s*region\\s*(.*)",
      "foldEnd": "# endregion",
      "foldEndRegex": "#\\s*endregion\\b"
    }
  },
  "json.schemaDownload.trustedDomains": {
    "https://docs.renovatebot.com/renovate-schema.json": true
  },
  "markdown.validate.ignoredLinks": [
    // START Ignore allcontributors links
    "#audio*",
    "#a11y*",
    "#bug*",
    "#blog*",
    "#business*",
    "#code*",
    "#content*",
    "#data*",
    "#doc*",
    "#design*",
    "#example*",
    "#eventOrganizing*",
    "#financial*",
    "#fundingFinding*",
    "#ideas*",
    "#infra*",
    "#maintenance*",
    "#mentoring*",
    "#platform*",
    "#plugin*",
    "#projectManagement*",
    "#promotion*",
    "#question*",
    "#research*",
    "#review*",
    "#security*",
    "#tool*",
    "#translation*",
    "#test*",
    "#tutorial*",
    "#talk*",
    "#userTesting*",
    "#video*",
    // END Ignore allcontributors links
  ],
  "ruff.configuration": "${workspaceFolder}/.config/ruff.toml",
  "ryl.configPath": ".config/ryl.toml",
  "typos.config": ".config/typos.toml"
}
